# Default deny: only reviewed public files are eligible for Git.
*
!*/
!/.github/workflows/ci.yml
!/.gitignore
!/LICENSE
!/README.md
!/command-guard/LICENSE
!/command-guard/README.md
!/command-guard/UPSTREAM.json
!/command-guard/adapters/pi/command-guard.ts
!/command-guard/hooks/dangerous-patterns.txt
!/command-guard/hooks/deny-dangerous.sh
!/command-guard/hooks/test-guard.sh
!/command-guard/skill/SKILL.md
!/command-guard/skill/agents/openai.yaml
!/npm-package-guard/LICENSE
!/npm-package-guard/README.md
!/npm-package-guard/bin/cli.js
!/npm-package-guard/package-lock.json
!/npm-package-guard/package.json
!/npm-package-guard/skill/SKILL.md
!/npm-package-guard/skill/agents/openai.yaml
!/npm-package-guard/skill/allowlist.txt
!/npm-package-guard/skill/scripts/install-hook.sh
!/npm-package-guard/skill/scripts/manage-hook.js
!/npm-package-guard/skill/scripts/npm-package-guard.js
!/npm-package-guard/skill/scripts/test.js
!/npm-package-guard/tests/cli.test.js
!/public-files.json
!/scripts/check-publication.py

# Private/generated files stay excluded even inside package directories.
.DS_Store
*.tgz
node_modules/

# Private material must remain outside this public repository.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
__pycache__/
private/
local/
memories/
chats/
sessions/
.codex/
.claude/
.pi/
